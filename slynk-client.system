(in-package "CL-USER")

(defvar *slynk-client-source-dir*
  (merge-pathnames "Github/slynk-client/" (translate-logical-pathname "EXTERN:")))
(defvar *slynk-client-binary-dir* (binary-directory *slynk-client-source-dir*))

(mk:defsystem :slynk-client
  :source-pathname *slynk-client-source-dir*
  :binary-pathname *slynk-client-binary-dir*
  :source-extension "lisp"
  :depends-on (:bordeaux-threads :alexandria :slynk :usocket)
  :components
  ((:module src
    :components
    ((:file "package")
     (:file "lib")
     (:file "slynk-client" :depends-on ("lib" "package"))))))

#+nil
(mk:oos :slynk-client :load :compile-during-load t)

(mk:defsystem :slynk-client/test
  :source-pathname *slynk-client-source-dir*
  :binary-pathname *slynk-client-binary-dir*
  :source-extension "lisp"
  :depends-on (:fiveam :slynk-client)
  :components
  ((:module tests
    :components
    ((:file "slynk-client-test")))))

#+nil
(mk:oos :slynk-client/test :load :compile-during-load t)

#+nil
(5am:run-all-tests)
